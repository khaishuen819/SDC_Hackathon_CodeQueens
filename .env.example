# Copy this file to .env and fill in real values. Never commit .env.
# On Replit, add the same names under Secrets instead.

# Neon PostgreSQL connection string (Neon dashboard > Connect). Placeholder only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# CV extraction provider: "mock" (default; no key needed; returns a fixed FICTIONAL profile) or "gemini".
LLM_PROVIDER="mock"
# Only needed when LLM_PROVIDER=gemini. Create a key in Google AI Studio. Placeholder only.
GEMINI_API_KEY="your-gemini-api-key"
# A current Gemini model ID from https://ai.google.dev/gemini-api/docs/models . Placeholder only.
GEMINI_MODEL="your-gemini-model-id"
